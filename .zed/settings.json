{
  "lsp": {
    "lua-language-server": {
      "settings": {
        "Lua": {
          "runtime": {
            "version": "LuaJIT",
            "builtin": {
              "basic": "disable",
              "bit": "disable",
              "bit32": "disable",
              "jit": "disable",
              "ffi": "disable",
              "os": "disable",
              "io": "disable",
              "debug": "disable",
              "string": "disable",
              "package": "disable",
              "utf8": "disable",
            },
          },
          "workspace": {
            "checkThirdParty": false,
            "library": [],
          },
          "diagnostics": {
            "disable": ["duplicate-set-field", "lowercase-global"],
          },
        },
      },
    },
  },
}
